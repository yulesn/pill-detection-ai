# Data & outputs (large / generated, not tracked)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
outputs/*
!outputs/checkpoints
!outputs/checkpoints/.gitkeep
!outputs/predictions
!outputs/predictions/.gitkeep

# Model weights
*.pt
*.pth
*.onnx

# Experiment tracking
wandb/
runs/
lightning_logs/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/

# Conda / venv
.conda/
venv/
.venv/

# OS / editor
.DS_Store
.vscode/
.idea/

# AI Hub 외부 데이터 (용량 문제로 git 제외, .gitkeep으로 폴더 구조만 유지)
!data/raw/aihub_pill/
data/raw/aihub_pill/*
!data/raw/aihub_pill/train_images/
!data/raw/aihub_pill/train_annotations/
data/raw/aihub_pill/train_images/*
data/raw/aihub_pill/train_annotations/*
!data/raw/aihub_pill/train_images/.gitkeep
!data/raw/aihub_pill/train_annotations/.gitkeep
